{
  "name": "tmux-desk",
  "version": "0.4.0",
  "description": "A desktop workspace for tmux sessions.",
  "author": "liwei",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "start": "npm run build:renderer && electron .",
    "build": "npm run build:renderer && npm run build:webapp",
    "build:renderer": "node scripts/build-renderer.js",
    "build:webapp": "node scripts/build-webapp.js",
    "serve:web": "npm run build:webapp && node src/server/index.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "package:mac": "npm run build && electron-builder --mac --arm64",
    "package:mac:x64": "npm run build && scripts/build-tmux.sh x64 && electron-builder --mac --x64",
    "package:mac:universal": "npm run build && scripts/build-tmux.sh x64 && scripts/build-tmux.sh arm64 && electron-builder --mac --universal",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "release:mac": "npm run build && scripts/release-mac.sh arm64",
    "release:mac:x64": "npm run build && scripts/release-mac.sh x64",
    "release:mac:universal": "npm run build && scripts/release-mac.sh universal"
  },
  "dependencies": {
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "proper-lockfile": "^4.1.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.liwei.tmux-desk",
    "productName": "Tmux Desk",
    "publish": null,
    "afterPack": "scripts/afterpack-adhoc.js",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "files": [
      "src/**/*",
      "renderer-dist/**/*",
      "webapp-dist/**/*",
      "package.json",
      "node_modules/node-pty/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/bin/${arch}",
        "to": "bin",
        "filter": [
          "tmux"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
